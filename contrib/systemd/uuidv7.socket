# Machine-wide uuidv7 service socket. Every local user may connect and request
# UUIDs; the service refuses the control commands (see uuidv7.service).
# systemd creates /run/uuidv7 owned by root, mode 0755, which is what clients
# require before they trust a socket there.
[Unit]
Description=uuidv7 machine-wide UUIDv7 socket

[Socket]
ListenStream=/run/uuidv7/uuidv7.sock
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
