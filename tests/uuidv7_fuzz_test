#!/usr/bin/env luajit
-- Fuzz / chaos test for the uuidv7 daemon. Bombards a real `uuidv7 --daemon` with
-- hostile protocol traffic — random/binary garbage, oversized and partial lines,
-- mid-request disconnects, log-injection attempts, misplaced handshake bytes, junk
-- retry tokens — and asserts ROBUSTNESS invariants:
--
--   1. The daemon never crashes: after every hostile burst a fresh PING still says OK.
--   2. Valid requests interleaved with the chaos still return well-formed UUIDs that
--      are unique and strictly increasing (correctness survives hostile neighbors).
--   3. The JSONL log stays valid + injection-proof (every line parses).
--   4. The daemon leaves no LuaJIT traceback on stderr.
--
-- Deterministic + reproducible: seed from UUIDV7_FUZZ_SEED (printed on every run), so
-- any failure can be replayed exactly. Iterations via UUIDV7_FUZZ_ITERS (default 600).

local self_dir = (arg and arg[0] or ""):match("^(.*)/[^/]+$") or "."
package.path = self_dir .. "/../lib/?.lua;" .. package.path
local client = require("uuidv7_client")

local tests, fails = 0, 0
local function ok(name, cond, detail)
	tests = tests + 1
	if cond then io.write("\u{2713} " .. name .. "\n")
	else io.stderr:write("\u{2717} " .. name .. (detail and (": " .. tostring(detail)) or "") .. "\n"); fails = fails + 1 end
end

local seed = tonumber(os.getenv("UUIDV7_FUZZ_SEED") or "") or 1234567
local iters = tonumber(os.getenv("UUIDV7_FUZZ_ITERS") or "") or 600
math.randomseed(seed)
io.write(string.format("fuzz seed=%d iters=%d (override via UUIDV7_FUZZ_SEED / UUIDV7_FUZZ_ITERS)\n", seed, iters))

local base = (os.getenv("TMPDIR") or "/tmp"):gsub("/+$", "")
local run = base .. "/uuidv7_fuzz_" .. tostring(os.time()) .. "_" .. tostring(seed)
os.execute("mkdir -p '" .. run .. "'")
local sock = run .. "/d.sock"
local logf = run .. "/d.log"
local exe = self_dir .. "/../bin/uuidv7"
local libp = self_dir .. "/../lib/?.lua;;"
local derrf = run .. "/derr"

local cmd = string.format(
	"env UUIDV7_SOCK=%q UUIDV7_LOG=%q LUA_PATH=%q UUIDV7_SILENCE_INSECURE_RANDOM=1 %q --daemon 2>%q",
	sock, logf, libp, exe, derrf)
local dh = io.popen(cmd, "r")
local function wait_ready()
	while true do local l = dh:read("*l"); if not l then return false end; if l:match("^UUIDV7%-LISTENING") then return true end end
end
ok("daemon announces listening", wait_ready())

local function is_uuid_compact(u) return type(u) == "string" and #u == 32 and u:sub(13, 13) == "7" end
local function rand_bytes(n) local t = {}; for i = 1, n do t[i] = string.char(math.random(0, 255)) end; return table.concat(t) end
local function rand_printable(n)
	local t = {}; for i = 1, n do t[i] = string.char(math.random(33, 126)) end; return table.concat(t)
end

-- Send a raw payload on a fresh connection, optionally draining the reply, then close.
-- Wrapped in pcall: a client-side error must never abort the fuzzer (we're testing the
-- SERVER's resilience, not the client's).
local function blast(payload, opts)
	opts = opts or {}
	pcall(function()
		local c = client.open(sock)
		if not c then return end
		if #payload > 0 then c:send_raw(payload) end
		if opts.shutdown then c:shutdown_wr() end
		if opts.drain then c:recv_all() end
		c:close()
	end)
end

-- The hostile-action menu. Each returns a payload + how to drive the connection.
local actions = {
	function() return rand_printable(math.random(1, 40)) .. "\n", { drain = true, shutdown = true } end, -- junk token line
	function() return rand_bytes(math.random(1, 64)) .. "\n", { drain = true, shutdown = true } end,      -- binary garbage line
	function() return rand_printable(math.random(80, 300)) .. "\n", { drain = true, shutdown = true } end, -- overlong line
	function() return rand_printable(math.random(1, 30)), {} end,                                          -- partial, no newline, no shutdown
	function() return rand_bytes(math.random(1, 30)), { shutdown = true, drain = true } end,               -- partial, then EOF
	function() return "zzz\nc5\n" .. rand_printable(5) .. "\n", { drain = true, shutdown = true } end,     -- pipelined valid+invalid
	function() return "", {} end,                                                                          -- connect then immediate close
	function() return 'x"\\\t\r}q' .. rand_printable(8) .. "\n", { drain = true, shutdown = true } end,    -- log-injection chars
	function() return "\22" .. rand_printable(10) .. "\n", { drain = true, shutdown = true } end,          -- stray SYN then junk
	function() return "c" .. string.rep("9", math.random(8, 20)) .. "\n", { drain = true, shutdown = true } end, -- huge count -> ERR
	function() return "R" .. math.random(1, 99) .. "W" .. math.random(0, 99999) .. rand_printable(3) .. "\n", { drain = true, shutdown = true } end, -- junk retry tokens
	function() return "c0\n", { drain = true, shutdown = true } end,                                       -- zero count -> ERR
}

-- Run the chaos, periodically interleaving a VALID request and checking correctness.
local seen, last_valid, valid_count = {}, "", 0
local crashes, dup, regress, baduuid = 0, 0, 0, 0
for i = 1, iters do
	local payload, opts = actions[math.random(#actions)]()
	blast(payload, opts)

	if i % 5 == 0 then
		-- Probe 1: the daemon must still be alive and answering control verbs.
		local pong = client.oneshot(sock, "PING")
		if pong ~= "OK\n" then crashes = crashes + 1 end
		-- Probe 2: a valid generation request amid the chaos must stay well-formed,
		-- unique, and strictly greater than the previous valid one.
		local u = (client.oneshot(sock, "") or ""):gsub("%s+$", "")
		if not is_uuid_compact(u) then baduuid = baduuid + 1
		else
			if seen[u] then dup = dup + 1 end
			if u <= last_valid then regress = regress + 1 end
			seen[u] = true; last_valid = u; valid_count = valid_count + 1
		end
	end
end

ok("daemon survived all hostile bursts (PING always OK)", crashes == 0, crashes .. " unanswered PINGs")
ok("valid requests amid chaos stayed well-formed", baduuid == 0, baduuid .. " malformed")
ok("no duplicate UUIDs amid chaos", dup == 0, dup .. " dupes over " .. valid_count .. " valids")
ok("valid UUIDs strictly increasing amid chaos", regress == 0, regress .. " regressions")
ok("collected a healthy sample of valid UUIDs", valid_count >= math.floor(iters / 5) - 1, valid_count)

-- Probe 3: status still parses after the onslaught.
local sj = client.oneshot(sock, "sj") or ""
ok("status still queryable after fuzzing", sj:match('"event":"stats"') ~= nil and sj:match('"uuids_served":%d+') ~= nil)

-- Probe 4: the log survived injection attempts as valid JSONL.
client.oneshot(sock, "l")
if os.execute("command -v jq >/dev/null 2>&1") then
	local rc = os.execute("jq . '" .. logf .. "' >/dev/null 2>&1")
	ok("log is valid JSON after injection attempts (jq)", rc == true or rc == 0)
else
	local good = true
	for l in io.lines(logf) do if not (l:match("^{.*}$") and l:match('"event":')) then good = false end end
	ok("log is valid JSONL after injection attempts", good)
end

-- Shut the daemon down and confirm it left no traceback on stderr.
client.oneshot(sock, "+++")
dh:read("*a"); dh:close()
local derr = ""
do local f = io.open(derrf, "r"); if f then derr = f:read("*a") or ""; f:close() end end
ok("daemon left no crash/traceback on stderr", #derr == 0, derr:sub(1, 200))

os.execute("rm-safe '" .. run .. "' >/dev/null 2>&1 || rm -rf '" .. run .. "' 2>/dev/null")
if fails > 0 then io.stderr:write(fails .. " of " .. tests .. " fuzz tests failed (replay with UUIDV7_FUZZ_SEED=" .. seed .. ")\n")
else io.write("All " .. tests .. " fuzz tests passed!\n") end
os.exit(fails)
