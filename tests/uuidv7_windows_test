#!/usr/bin/env bash
# Windows-only CLI contract (run under Git Bash/MSYS with a native luajit.exe):
# no daemon by design, secure RNG (no insecure-fallback warning), and a
# LockFileEx-locked counter file that keeps separate processes strictly ordered.
set -u

case "$(uname -s)" in
	MINGW*|MSYS*|CYGWIN*) ;;
	*) echo "n/a: Windows-only suite (this OS: $(uname -s))"; exit 0 ;;
esac

export UUIDV7_NO_DAEMON=1
TMPDIR="$(mktemp -d)"; export TMPDIR
trap 'rm -rf "$TMPDIR"' EXIT
capture() { out="$("$@" 2>"$TMPDIR/stderr")"; rc=$?; err="$(cat "$TMPDIR/stderr")"; }

tests=0 fails=0
pass() { tests=$((tests + 1)); echo "✓ $1"; }
fail() { tests=$((tests + 1)); fails=$((fails + 1)); echo "✗ $1" >&2; }
check() { if eval "$2"; then pass "$1"; else fail "$1 [$2]"; fi; }

capture uuidv7 --daemon
check "--daemon refuses on Windows (exit 1)" '[ "$rc" -eq 1 ]'
check "--daemon refusal names Windows" '[[ "$err" == *"not supported on Windows"* ]]'
check "--daemon prints nothing on stdout" '[ -z "$out" ]'

capture uuidv7 --api s
check "--api refuses on Windows (exit 1)" '[ "$rc" -eq 1 ]'
check "--api refusal names Windows" '[[ "$err" == *"not supported on Windows"* ]]'

capture uuidv7
check "plain generation succeeds" '[ "$rc" -eq 0 ]'
check "plain generation is 32 hex" '[[ "$out" =~ ^[0-9a-f]{32}$ ]]'
check "no stderr (secure RNG, no fallback warning)" '[ -z "$err" ]'

capture env -u UUIDV7_NO_DAEMON uuidv7 --hyphen
check "generation without UUIDV7_NO_DAEMON succeeds (no daemon probe)" '[ "$rc" -eq 0 ] && [ -z "$err" ]'
check "generation without UUIDV7_NO_DAEMON is a hyphenated uuid" '[[ "$out" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]]'

capture uuidv7 --hyphen 1700000000000000123
check "static timestamp is exact" '[[ "$out" == 018bcfe5-6800-7000-9e* ]]'

# Separate processes, same static nanosecond: only the shared locked counter file
# can make these strictly increasing.
prev="" ordered=1
for i in $(seq 1 40); do
	cur="$(uuidv7 1700000000000000000)"
	if [ -n "$prev" ] && ! [[ "$cur" > "$prev" ]]; then ordered=0; fi
	prev="$cur"
done
check "40 processes at one static ns are strictly increasing" '[ "$ordered" -eq 1 ]'

# Concurrent processes contend for the lock; every value must be unique.
for w in 1 2 3 4 5 6; do
	( for i in $(seq 1 15); do uuidv7 1700000000000000000; done > "$TMPDIR/w$w" ) &
done
wait
total="$(cat "$TMPDIR"/w1 "$TMPDIR"/w2 "$TMPDIR"/w3 "$TMPDIR"/w4 "$TMPDIR"/w5 "$TMPDIR"/w6 | wc -l)"
uniq_n="$(cat "$TMPDIR"/w1 "$TMPDIR"/w2 "$TMPDIR"/w3 "$TMPDIR"/w4 "$TMPDIR"/w5 "$TMPDIR"/w6 | sort -u | wc -l)"
check "6 concurrent workers x 15: 90 values" '[ "$total" -eq 90 ]'
check "6 concurrent workers x 15: all unique" '[ "$uniq_n" -eq 90 ]'

echo "$((tests - fails))/$tests Windows tests passed"
[ "$fails" -eq 0 ]
