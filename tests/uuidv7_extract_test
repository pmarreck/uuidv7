#!/usr/bin/env bash

# Force local generation (never route to a daemon) so these tests are deterministic.
export UUIDV7_NO_DAEMON=1
# Contract test for timestamp extraction: round-trip the original epoch timestamp
# back out of a generated UUIDv7, minus any randomization or counter increments.
#
#   --extract-timestamp-ms <uuid>   -> 48-bit unix_ts_ms field (epoch milliseconds)
#   --extract-timestamp-ns <uuid>   -> full epoch nanoseconds (ms*1e6 + sub-ms ns)
#   --extract-timestamp    <uuid>   -> defaults to ms
# Accepts the UUID with or without hyphens, any capitalization.
#
# The sub-ms nanosecond bits are only meaningful for UUIDs generated by THIS tool
# (a foreign RFC 9562 v7 has random bits there), so --extract-timestamp-ns warns to
# stderr unless muted via --mute-warning or UUIDV7_NS_EXTRACT_OK=1|true.

set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$here/../bin:$PATH"

tests=0
fails=0
assert_eq() {
	(( tests++ ))
	if [[ "$2" == "$3" ]]; then
		echo "✓ $1 ($2)"
	else
		echo "✗ $1: expected '$3', got '$2'" >&2
		(( fails++ ))
	fi
}

# Isolate the shared counter state so the first call is a fresh tick.
TMPDIR="$(mktemp -d)"; export TMPDIR
trap 'rm -rf "$TMPDIR"' EXIT

# Fixed inputs: RFC A.6 millisecond + a deliberately bit-spread sub-ms nanosecond.
MS=1645557742000          # 0x017F22E279B0  (RFC 9562 A.6 timestamp)
NS_IN_MS=524287           # 0x7FFFF
NT=$(( MS * 1000000 + NS_IN_MS ))   # 1645557742000524287  (> 2^53; needs 64-bit parse)

u=$(uuidv7 "$NT")                 # 32 hex chars, no hyphens
uh=$(uuidv7 - "$NT")              # hyphenated form
echo "uuid (compact)    = $u"
echo "uuid (hyphenated) = $uh"

# Mute the ns warning for the bulk round-trip assertions (tested explicitly below).
export UUIDV7_NS_EXTRACT_OK=1

# --- nanosecond extraction round-trips the full original timestamp ---
assert_eq "extract-ns (compact)"     "$(uuidv7 --extract-timestamp-ns "$u")"  "$NT"
assert_eq "extract-ns (hyphenated)"  "$(uuidv7 --extract-timestamp-ns "$uh")" "$NT"
assert_eq "extract-ns (uppercase)"   "$(uuidv7 --extract-timestamp-ns "${u^^}")" "$NT"

# --- millisecond extraction round-trips the 48-bit ms field ---
assert_eq "extract-ms (compact)"     "$(uuidv7 --extract-timestamp-ms "$u")"  "$MS"
assert_eq "extract-ms (hyphenated)"  "$(uuidv7 --extract-timestamp-ms "$uh")" "$MS"

# --- bare --extract-timestamp defaults to ms ---
assert_eq "extract default = ms"     "$(uuidv7 --extract-timestamp "$u")"     "$MS"

# --- counter increments must NOT change the extracted timestamp ---
# Second call at the same nanosecond bumps the counter; the timestamp is unaffected.
u2=$(uuidv7 "$NT")
assert_eq "counter bump changes uuid" "$([[ "$u" != "$u2" ]] && echo yes || echo no)" "yes"
assert_eq "extract-ns ignores counter" "$(uuidv7 --extract-timestamp-ns "$u2")" "$NT"

# --- a second, independent timestamp also round-trips ---
MS2=1700000000123
NS2=0
NT2=$(( MS2 * 1000000 + NS2 ))
v=$(uuidv7 "$NT2")
assert_eq "extract-ns other ts"  "$(uuidv7 --extract-timestamp-ns "$v")" "$NT2"
assert_eq "extract-ms other ts"  "$(uuidv7 --extract-timestamp-ms "$v")" "$MS2"

# --- invalid input fails loudly (non-zero exit), does not print a bogus number ---
if uuidv7 --extract-timestamp-ms "not-a-uuid" >/dev/null 2>&1; then
	echo "✗ invalid input should exit non-zero" >&2
	(( tests++ )); (( fails++ ))
else
	(( tests++ )); echo "✓ invalid input exits non-zero"
fi

# =====================================================================
# ns-extract warning behavior (drop the mute so default behavior shows)
# =====================================================================
unset UUIDV7_NS_EXTRACT_OK

# By default, --extract-timestamp-ns warns on stderr; stdout stays the clean value.
ns_err=$(uuidv7 --extract-timestamp-ns "$u" 2>&1 >/dev/null)
assert_eq "ns warns by default"        "$([[ -n "$ns_err" ]] && echo yes || echo no)" "yes"
assert_eq "ns value clean on stdout"   "$(uuidv7 --extract-timestamp-ns "$u" 2>/dev/null)" "$NT"

# --mute-warning silences it, in either argument order.
mw1=$(uuidv7 --extract-timestamp-ns "$u" --mute-warning 2>&1 >/dev/null)
assert_eq "--mute-warning (after uuid) silences" "$([[ -z "$mw1" ]] && echo yes || echo no)" "yes"
assert_eq "--mute-warning (before uuid) value"   "$(uuidv7 --extract-timestamp-ns --mute-warning "$u" 2>/dev/null)" "$NT"
mw2=$(uuidv7 --extract-timestamp-ns --mute-warning "$u" 2>&1 >/dev/null)
assert_eq "--mute-warning (before uuid) silences" "$([[ -z "$mw2" ]] && echo yes || echo no)" "yes"

# UUIDV7_NS_EXTRACT_OK=1 and =true silence it.
e1=$(UUIDV7_NS_EXTRACT_OK=1 uuidv7 --extract-timestamp-ns "$u" 2>&1 >/dev/null)
assert_eq "env=1 silences"    "$([[ -z "$e1" ]] && echo yes || echo no)" "yes"
et=$(UUIDV7_NS_EXTRACT_OK=true uuidv7 --extract-timestamp-ns "$u" 2>&1 >/dev/null)
assert_eq "env=true silences" "$([[ -z "$et" ]] && echo yes || echo no)" "yes"

# The ms field is the standard 48-bit field — always valid, so never warn.
ms_err=$(uuidv7 --extract-timestamp-ms "$u" 2>&1 >/dev/null)
assert_eq "ms never warns" "$([[ -z "$ms_err" ]] && echo yes || echo no)" "yes"

if (( fails > 0 )); then
	echo "$fails of $tests extract tests failed!" >&2
else
	echo "All $tests extract tests passed!"
fi
exit "$fails"
